<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- The game's real rules core, compiled as-is. Only the value-pinning Validate() is replaced so that
         candidate configs can be simulated; see ConfigValidationRelaxed.cs. -->
    <Compile Include="../../DicePrototype/Assets/Game/Core/Rules/*.cs" Exclude="../../DicePrototype/Assets/Game/Core/Rules/ConfigValidation.cs" />
    <Compile Include="../../DicePrototype/Assets/Game/Core/Session/*.cs" />
  </ItemGroup>
</Project>
